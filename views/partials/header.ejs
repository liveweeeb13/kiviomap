<!DOCTYPE html>
<html lang="<%= lang || 'fr' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' • Kiviomap' : 'Kiviomap • Carte Wi-Fi collaborative' %></title>
  <meta name="description" content="<%= typeof pageDesc !== 'undefined' ? pageDesc : 'Kiviomap est une carte Wi-Fi collaborative. Trouvez, ajoutez et vérifiez des réseaux Wi-Fi publics autour de vous.' %>">
  <meta name="robots" content="index, follow">
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <link rel="canonical" href="<%= typeof appUrl !== 'undefined' ? appUrl : '' %><%= typeof canonicalPath !== 'undefined' ? canonicalPath : '' %>">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Kiviomap">
  <meta property="og:title" content="<%= typeof pageTitle !== 'undefined' ? pageTitle + ' • Kiviomap' : 'Kiviomap • Carte Wi-Fi collaborative' %>">
  <meta property="og:description" content="<%= typeof pageDesc !== 'undefined' ? pageDesc : 'Kiviomap est une carte Wi-Fi collaborative. Trouvez, ajoutez et vérifiez des réseaux Wi-Fi publics autour de vous.' %>">
  <meta property="og:image" content="<%= process.env.APP_URL || '' %>/img/logo.png">
  <meta property="og:url" content="<%= process.env.APP_URL || '' %><%= typeof canonicalPath !== 'undefined' ? canonicalPath : '' %>">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="<%= typeof pageTitle !== 'undefined' ? pageTitle + ' • Kiviomap' : 'Kiviomap • Carte Wi-Fi collaborative' %>">
  <meta name="twitter:description" content="<%= typeof pageDesc !== 'undefined' ? pageDesc : 'Kiviomap est une carte Wi-Fi collaborative. Trouvez, ajoutez et vérifiez des réseaux Wi-Fi publics autour de vous.' %>">
  <meta name="twitter:image" content="<%= process.env.APP_URL || '' %>/img/logo.png">
  <link rel="icon" type="image/png" href="/img/logo.png">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css?v=6">
  
</head>
<body data-is-logged="<%= user ? 'true' : 'false' %>">
<nav class="navbar">
  <a class="nav-brand" href="/">Kiviomap</a>
  <div class="nav-links">
    <a href="/leaderboard"><%= t.nav.leaderboard %></a>
    <button type="button" class="btn-primary donate-trigger" aria-haspopup="dialog" aria-controls="donate-modal">Faire un don</button>
    <% if (user) { %>
      <% if (user.role === 'admin') { %><a href="/admin" class="btn-primary"><%= t.nav.admin %></a><% } %>
      <a href="/u/<%= user.id %>" class="user-badge">
        <%= user.username %>
        <small><%= user.points %> pts</small>
      </a>
    <% } else { %>
      <a href="/auth/login"><%= t.nav.login %></a>
      <a href="/auth/register" class="btn-primary nav-register-btn"><%= t.nav.register %></a>
    <% } %>
    <!-- <a href="/lang/<%= lang === 'fr' ? 'en' : 'fr' %>" title="Switch language" style="font-size:1.3rem;text-decoration:none;line-height:1"><%= lang === 'fr' ? '🇫🇷' : '🇬🇧' %></a>
    --> </div>
</nav>
<script>
  (() => {
    const navbar = document.querySelector('.navbar');
    if (!navbar) return;
    const brand = navbar.querySelector('.nav-brand');
    const links = navbar.querySelector('.nav-links');
    if (!brand || !links) return;

    let brandW = 0;
    const checkNavbarOverflow = () => {
      if (brand.offsetWidth > 0) brandW = brand.offsetWidth;
      const isHidden = navbar.classList.contains('hide-brand');
      const cs = getComputedStyle(navbar);
      const pad = parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight);
      const available = navbar.clientWidth - pad;

      if (!isHidden) {
        const needed = brand.offsetWidth + links.offsetWidth + 12;
        if (needed > available || navbar.scrollWidth > navbar.clientWidth + 1) {
          navbar.classList.add('hide-brand');
        }
      } else {
        const neededWithBrand = (brandW || 75) + links.offsetWidth + 16;
        if (available >= neededWithBrand) {
          navbar.classList.remove('hide-brand');
        }
      }
    };

    window.addEventListener('resize', checkNavbarOverflow, { passive: true });
    window.addEventListener('DOMContentLoaded', checkNavbarOverflow);
    checkNavbarOverflow();
    setTimeout(checkNavbarOverflow, 100);
  })();
</script>
