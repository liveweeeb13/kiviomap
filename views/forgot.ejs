<%- include('partials/header') %>
<div class="auth-page">
  <div class="auth-box">
    <h1><%= t.forgot.title %></h1>
    <p class="auth-subtitle"><%= t.forgot.subtitle %></p>
    <% if (error) { %><div class="alert-error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert-success"><%= success %></div><% } %>
    <% if (!success) { %>
    <form method="POST" action="/auth/forgot">
      <label><%= t.forgot.email %><input type="email" name="email" required autofocus placeholder="vous@exemple.com"></label>
      <button type="submit" class="btn-primary btn-full"><%= t.forgot.submit %></button>
    </form>
    <% } %>
    <p class="auth-link"><a href="/auth/login"><%= t.forgot.back %></a></p>
  </div>
</div>
<%- include('partials/footer') %>
