<%- include('partials/header') %>
<div class="auth-page">
  <div class="auth-box">
    <h1><%= t.reset.title %></h1>
    <p class="auth-subtitle"><%= t.reset.subtitle %></p>
    <% if (error) { %><div class="alert-error"><%= error %></div><% } %>
    <form method="POST" action="/auth/reset/<%= token %>">
      <label><%= t.reset.new_password %><input type="password" name="password" required autofocus placeholder="••••••••" minlength="6"></label>
      <label><%= t.reset.confirm %><input type="password" name="confirm_password" required placeholder="••••••••"></label>
      <button type="submit" class="btn-primary btn-full"><%= t.reset.submit %></button>
    </form>
    <p class="auth-link"><a href="/auth/login"><%= t.reset.back %></a></p>
  </div>
</div>
<%- include('partials/footer') %>
