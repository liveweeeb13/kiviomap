<%- include('partials/header') %>
<div class="auth-page">
  <div class="auth-box">
    <h1><%= t.login.title %></h1>
    <p class="auth-subtitle"><%= t.login.subtitle %></p>
    <% if (error) { %><div class="alert-error"><%= error %></div><% } %>
    <% if (typeof success !== 'undefined' && success) { %><div class="alert-success"><%= success %></div><% } %>
    <form method="POST" action="/auth/login">
      <label><%= t.login.email %><input type="email" name="email" required autofocus placeholder="vous@exemple.com"></label>
      <label><%= t.login.password %><input type="password" name="password" required placeholder="••••••••"></label>
      <button type="submit" class="btn-primary btn-full"><%= t.login.submit %></button>
    </form>
    <p class="auth-link"><a href="/auth/forgot"><%= t.login.forgot %></a></p>
    <p class="auth-link"><%= t.login.no_account %> <a href="/auth/register"><%= t.login.register_link %></a></p>
  </div>
</div>
<%- include('partials/footer') %>
