<%- include('partials/header') %>
<div class="leaderboard-page">
  <h1><%= t.leaderboard.title %></h1>
  <div class="lb-grid">
    <div class="detail-card">
      <h3><%= t.leaderboard.top_contributors %></h3>
      <ol>
        <% topPoints.forEach((u, i) => { %>
        <li>
          <span class="lb-rank"><%= i+1 %></span>
          <a href="/u/<%= u.id %>" class="user-badge" style="text-decoration:none"><%= u.username %></a>
          <span class="lb-pts"><%= u.points %> <%= t.leaderboard.pts %></span>
        </li>
        <% }) %>
      </ol>
    </div>
    <div class="detail-card">
      <h3><%= t.leaderboard.top_networks %></h3>
      <ol>
        <% topNetworks.forEach((u, i) => { %>
        <li><span class="lb-rank"><%= i+1 %></span> <a href="/u/<%= u.id %>" style="color:var(--text);text-decoration:none"><%= u.username %></a> <span class="lb-pts"><%= u.count %> <%= t.leaderboard.networks %></span></li>
        <% }) %>
      </ol>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
